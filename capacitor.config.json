{
  "appId": "com.astra.beyondthestars",
  "appName": "ASTRA — Beyond the Stars",
  "webDir": "dist",
  "server": {
    "androidScheme": "https",
    "allowNavigation": []
  },
  "android": {
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": true,
    "loggingBehavior": "none",
    "backgroundColor": "#020a18"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#020a18",
      "showSpinner": false
    }
  }
}
